{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "iMeditate theme content",
  "type": "object",
  "required": ["theme", "scriptures"],
  "properties": {
    "theme": {
      "type": "object",
      "required": ["id", "title", "is_free"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "is_free": { "type": "boolean" }
      }
    },
    "scriptures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "ref", "text", "phrases", "questions"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "ref": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "phrases": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "questions": {
            "type": "object",
            "required": ["4-7", "8-11", "12-17"],
            "properties": {
              "4-7": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "8-11": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "12-17": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            }
          },
          "audio_url": { "type": ["string", "null"] },
          "sort": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
