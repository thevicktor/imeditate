# Copy to server/.env (never commit .env). Dev defaults for local Docker stack.
PORT=3000
DATABASE_URL=postgres://imeditate:imeditate_dev_only@localhost:5432/imeditate
BETTER_AUTH_SECRET=dev-only-change-me
# R2 (presigned URLs; bucket private)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=imeditate-dev
# Auth email (magic links) — free-tier SMTP for dev
SMTP_URL=
